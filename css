* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f6f8;
    color: #222;
    line-height: 1.6;
}

/* Resume Container */
.resume {
    max-width: 950px;
    margin: 30px auto;
    background: white;
    padding: 45px;
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.12);
    border-radius: 10px;
}

/* Header */
header {
    text-align: center;
    padding-bottom: 25px;
    border-bottom: 2px solid #222;
}

header h1 {
    font-size: 40px;
    margin-bottom: 8px;
}

header p {
    font-size: 18px;
    color: #555;
}

.contact {
    margin-top: 12px;
    font-size: 14px;
}

.contact a {
    color: #222;
    text-decoration: none;
}

.contact a:hover {
    text-decoration: underline;
}

/* Navigation */
nav {
    text-align: center;
    margin: 25px 0;
}

nav a {
    display: inline-block;
    margin: 5px 10px;
    color: #222;
    text-decoration: none;
    font-weight: bold;
}

nav a:hover {
    color: #0077cc;
}

/* Sections */
section {
    margin-bottom: 30px;
}

h2 {
    font-size: 23px;
    margin-bottom: 15px;
    padding-bottom: 7px;
    border-bottom: 1px solid #ccc;
}

/* Skills */
.skills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.skill {
    background: #eeeeee;
    padding: 8px 15px;
    border-radius: 20px;
    font-size: 14px;
    transition: 0.3s;
}

.skill:hover {
    transform: translateY(-3px);
}

/* Projects */
.project {
    padding: 15px;
    margin-bottom: 15px;
    border-left: 4px solid #222;
    background: #f8f8f8;
    transition: 0.3s;
}

.project:hover {
    transform: translateX(5px);
}

/* Lists */
ul {
    margin-left: 20px;
}

li {
    margin-bottom: 6px;
}

