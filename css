* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #eef1f5;
    color: #222;
    line-height: 1.6;
}


/* Main Resume */

.resume {
    max-width: 950px;
    margin: 30px auto;
    background: white;
    padding: 45px;
    border-radius: 12px;
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.12);
}


/* Header */

header {
    border-bottom: 2px solid #222;
    padding-bottom: 25px;
}

.profile {
    display: flex;
    align-items: center;
    gap: 20px;
}


/* Profile Photo */

.profile-photo {
    width: 100px;
    height: 100px;

    border-radius: 50%;

    background: #222;
    color: white;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 30px;
    font-weight: bold;
}


header h1 {
    font-size: 38px;
    margin-bottom: 5px;
}

header p {
    color: #555;
    font-size: 17px;
}

.career {
    font-weight: bold;
}


/* Contact */

.contact {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;

    margin-top: 20px;

    font-size: 14px;
}


/* Navigation */

nav {
    text-align: center;
    padding: 20px 0;
    border-bottom: 1px solid #ddd;
}

nav a {
    text-decoration: none;
    color: #222;

    font-weight: bold;

    margin: 0 12px;

    transition: 0.3s;
}

nav a:hover {
    color: #0077cc;
}


/* Sections */

section {
    margin-top: 30px;
}

h2 {
    font-size: 23px;

    border-bottom: 2px solid #222;

    padding-bottom: 7px;

    margin-bottom: 15px;
}

section p {
    margin-bottom: 10px;
}


/* Education */

.education-box {
    background: #f7f7f7;

    padding: 15px;

    margin-bottom: 12px;

    border-left: 4px solid #222;

    border-radius: 5px;
}

.education-box h3 {
    margin-bottom: 5px;
}


/* Skills */

.skills {
    display: flex;

    flex-wrap: wrap;

    gap: 12px;
}

.skills span {
    background: #222;

    color: white;

    padding: 8px 16px;

    border-radius: 20px;

    font-size: 14px;

    transition: 0.3s;
}

.skills span:hover {
    transform: translateY(-3px);
}


/* Projects */

.project {
    background: #f7f7f7;

    padding: 18px;

    margin-bottom: 15px;

    border-left: 4px solid #222;

    border-radius: 5px;

    transition: 0.3s;
}

.project:hover {
    transform: translateX(5px);

    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
}

.project h3 {
    margin-bottom: 5px;
}


/* Lists */

ul {
    margin-left: 22px;
}

li {
    margin-bottom: 7px;
}


/* Buttons */

.buttons {
    text-align: center;

    margin-top: 35px;
}

button {
    border: none;

    background: #222;

    color: white;

    padding: 12px 20px;

    margin: 5px;

    border-radius: 6px;

    cursor: pointer;

    font-size: 15px;

    transition: 0.3s;
}

button:hover {
    background: #444;

    transform: translateY(-2px);
}


/* Footer */

footer {
    text-align: center;

    border-top: 1px solid #ddd;

    margin-top: 35px;

    padding-top: 20px;

    color: #777;

    font-size: 13px;
}


/* Mobile */

@media (max-width: 650px) {

    .resume {
        margin: 10px;

        padding: 25px;
    }

    .profile {
        flex-direction: column;

        text-align: center;
    }

    header h1 {
        font-size: 30px;
    }

    .contact {
        justify-content: center;

        flex-direction: column;

        align-items: center;
    }

    nav a {
        display: block;

        margin: 8px;
    }

    h2 {
        font-size: 20px;
    }
}


/* Print */

@media print {

    body {
        background: white;
    }

    .resume {
        margin: 0;

        max-width: 100%;

        box-shadow: none;
    }

    nav,
    .buttons {
        display: none;
    }
}